# ── Agent WhatsApp (api/whatsapp.js) ─────────────────────────────
# Copier ces clés dans Vercel → Project Settings → Environment Variables
# (Production + Preview). Ne PAS committer de vraie valeur : .env est gitignoré.

# Meta / WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=choisir-une-chaine-secrete-quelconque
WHATSAPP_TOKEN=EAAG...le-token-permanent
WHATSAPP_PHONE_NUMBER_ID=1234567890

# LLM — API compatible OpenAI. Choisir UN fournisseur gratuit :
#   Mistral    LLM_BASE_URL=https://api.mistral.ai/v1       LLM_MODEL=ministral-8b-latest   (défaut)
#   Groq       LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter LLM_BASE_URL=https://openrouter.ai/api/v1    LLM_MODEL=minimax/minimax-m3:free
LLM_API_KEY=cle-du-fournisseur
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=ministral-8b-latest

# Upstash Redis (base gratuite — https://upstash.com)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# Numéro qui reçoit les alertes "lead à rappeler" (format international sans +)
OWNER_WHATSAPP=212663449200
